# Local dev:  cp .env.example backend/.env
# Docker:     cp .env.example .env   (compose reads ANTHROPIC_*, *_SECRET and ADMIN_API_KEY from it;
#                                     database/redis URLs are set by docker-compose.yml)
# Never commit real values.

# --- Database / queue (docker compose maps these ports on localhost) ---
DATABASE_URL=postgresql://wishluck:wishluck@localhost:5455/wishluck
REDIS_URL=redis://localhost:6385

# --- Server ---
PORT=4000
PUBLIC_API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
LOG_LEVEL=info

# --- Claude (leave ANTHROPIC_API_KEY empty to run in clearly-labelled MOCK mode) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
LLM_TIMEOUT_MS=20000
LLM_MAX_RETRIES=2

# --- Webhook signing secrets (HMAC-SHA256 of the raw body, hex) ---
ORDER_WEBHOOK_SECRET=change-me-order-secret
COURIER_WEBHOOK_SECRET=change-me-courier-secret

# --- Optional Telegram channel (bot token from @BotFather). Leave empty to disable. ---
TELEGRAM_BOT_TOKEN=
# Optional: chat/group id that receives a message for every new order (send /chatid to the bot to find it)
TEAM_TELEGRAM_CHAT_ID=

# --- Hosting (single free web service): run worker + Telegram inside the API process ---
RUN_WORKER=false
# polling = local (no public URL needed); webhook = production (Telegram calls PUBLIC_API_URL/telegram/webhook)
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_SECRET=

# --- Dashboard access (simple shared key for the internal admin API) ---
ADMIN_API_KEY=change-me-admin-key
