# Copy to backend/.env  (never commit real values)

# --- Database / queue (docker compose maps these ports on localhost) ---
DATABASE_URL=postgresql://wishluck:wishluck@localhost:5455/wishluck
REDIS_URL=redis://localhost:6385

# --- Server ---
PORT=4000
PUBLIC_API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
LOG_LEVEL=info

# --- Claude (leave ANTHROPIC_API_KEY empty to run in clearly-labelled MOCK mode) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
LLM_TIMEOUT_MS=20000
LLM_MAX_RETRIES=2

# --- Webhook signing secrets (HMAC-SHA256 of the raw body, hex) ---
ORDER_WEBHOOK_SECRET=change-me-order-secret
COURIER_WEBHOOK_SECRET=change-me-courier-secret

# --- Dashboard access (simple shared key for the internal admin API) ---
ADMIN_API_KEY=change-me-admin-key
